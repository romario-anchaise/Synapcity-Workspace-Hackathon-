PORT=3000
INTERNAL_API_KEY=clave-secreta-interna-cambiala-en-produccion

# Nueva aplicación Rapicostura (npm run bot). Node.js 22.13+; recomendado 24/26.
BOT_HOST=127.0.0.1
BOT_PORT=8090
# BOT_DB=/ruta/privada/rapicostura.sqlite
# IA local (Ollama): responde preguntas sobre la empresa y entiende fechas escritas.
# Vacío = sin IA, el bot usa solo las preguntas frecuentes. También se cambia en /setup/.
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_URL=http://127.0.0.1:11434
# En CPU lenta sube el tiempo máximo de espera (milisegundos).
# OLLAMA_TIMEOUT_MS=45000
# Groq/Gemini (opcional, en la nube): SOLO reciben expresiones de fecha.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Genera un secreto propio para revisar solicitudes en /admin/requests.
ADMIN_TOKEN=
COOKIE_SECURE=false
# Con una sesión ya vinculada el bot se reconecta solo al arrancar.
# true = conectar siempre; false = no conectar aunque haya sesión guardada.
# WHATSAPP_ENABLED=
# JIDs autorizados separados por comas. Ejemplo: 51999999999@s.whatsapp.net
WHATSAPP_ALLOWED_JIDS=

# Gemini (también se configura desde http://localhost:8090/setup/)
# IA que responde preguntas y fechas: gemini | ollama (groq solo fechas).
# Vacío = Gemini si hay clave; si no, Ollama.
# DATE_AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Configuración y datos privados: ~/.local/share/rapicostura-bot/
